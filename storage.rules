rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny all access
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource != null &&
             request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|avif)') &&
             request.resource.size <= 10 * 1024 * 1024; // 10 MB maximum
    }

    // Pin images uploaded by users
    // Path: pins/{userId}/{fileName}
    match /pins/{userId}/{fileName} {
      // Public read allowed for pin pictures
      allow read: if true;

      // Only the authenticated user can upload to their own folder, enforcing 10MB limit and image MIME types
      allow create: if isOwner(userId) && isValidImage();

      // Only the owner can update their own image
      allow update: if isOwner(userId) && isValidImage();

      // Only the owner can delete their own image
      allow delete: if isOwner(userId);
    }

    // Profile and Avatar images
    // Path: profile-images/{userId}/{fileName}
    match /profile-images/{userId}/{fileName} {
      // Public read allowed for avatar images
      allow read: if true;

      // Only the profile owner can upload their avatar, with image validation
      allow create: if isOwner(userId) && isValidImage();

      // Only the profile owner can update their avatar
      allow update: if isOwner(userId) && isValidImage();

      // Only the profile owner can delete their avatar
      allow delete: if isOwner(userId);
    }
  }
}
