rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny all access
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource != null &&
             request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|avif)') &&
             request.resource.size > 0 &&
             request.resource.size <= 10 * 1024 * 1024; // 10 MB maximum
    }

    // Preserve existing pin images. New objects use a backend-only prefix.
    match /pins/{userId}/{fileName} {
      allow get: if resource.metadata.get('heyroqRestricted', '') != '1';
    }
    match /pin-images/{userId}/{pinId}/{incarnation}/{uploadId} {
      allow get: if resource.metadata.get('heyroqRestricted', '') != '1';
    }

    // Managed objects are written by Admin and served through per-object bearer URLs.
    match /pin-images-v2/{userId}/{pinId}/{incarnation}/{uploadId} {
      allow read, write: if false;
    }

    // Profile and Avatar images
    // Path: profile-images/{userId}/{fileName}
    match /profile-images/{userId}/{fileName} {
      // Public read allowed for avatar images
      allow get: if true;

      // Avatar bytes are accepted only by the callable using the named Firestore lock.
      allow create, update: if false;

      // Only the profile owner can delete their avatar
      allow delete: if isOwner(userId);
    }
  }
}
