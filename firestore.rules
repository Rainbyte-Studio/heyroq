rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // Default Deny All: Prevent any unauthorized document access
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isSignedIn() &&
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Stop authenticated clients from creating new data while account deletion runs.
    function isActiveUser(userId) {
      return !exists(/databases/$(database)/documents/accountDeletionLocks/$(userId)) &&
             exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.get('deletionStatus', '') != 'deleting';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (request.auth.uid == '1XUiIYnfOWTG7uFU736I25CskZU2' &&
         request.auth.token.email == 'n.kalogerogiannis@gmail.com')
      );
    }

    function validUsername(username) {
      return username is string && username.matches('^[a-z0-9_]{3,24}$');
    }

    function usernameRegistryReady() {
      return get(/databases/$(database)/documents/usernameRegistryState/v1).data.ready == true;
    }

    function hasUsernameClaim(userId, data) {
      return validUsername(data.username) && data.usernameLower == data.username &&
        getAfter(/databases/$(database)/documents/usernames/$(data.username)).data.uid == userId;
    }

    function usernameWriteAllowed(userId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['username', 'usernameLower']) ||
        (usernameRegistryReady() && isNonAnonymous() && isOwner(userId) && isActiveUser(userId) &&
          hasUsernameClaim(userId, request.resource.data));
    }

    function canClaimUsername(username) {
      let uid = request.auth.uid;
      let profile = /databases/$(database)/documents/users/$(uid);
      return isNonAnonymous() && usernameRegistryReady() && validUsername(username) &&
        request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid &&
        !exists(/databases/$(database)/documents/accountDeletionLocks/$(uid)) &&
        getAfter(profile).data.username == username &&
        getAfter(profile).data.usernameLower == username &&
        getAfter(profile).data.get('deletionStatus', '') != 'deleting';
    }

    function isClaimOwnerCurrent(username) {
      let owner = /databases/$(database)/documents/users/$(resource.data.uid);
      return exists(owner) && get(owner).data.get('username', '') == resource.data.get('legacyUsername', username);
    }

    match /usernameRegistryState/v1 {
      allow get: if true;
    }

    match /usernames/{username} {
      allow get: if true;
      allow create: if canClaimUsername(username);
      allow update: if canClaimUsername(username) && resource.data.get('blocked', false) == false &&
        (resource.data.uid == request.auth.uid || !isClaimOwnerCurrent(username));
      allow delete: if usernameRegistryReady() && isNonAnonymous() && resource.data.uid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username !=
          resource.data.get('legacyUsername', username) &&
        hasUsernameClaim(request.auth.uid, getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    // User profile creation validation
    function isValidUserCreate(data, userId) {
      return (
        data.username is string && data.username.size() >= 2 && data.username.size() <= 50 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        !('email' in data) &&
        (!('uid' in data) || data.uid == userId) &&
        (!('role' in data) || data.role == 'user' || isAdmin()) &&
        !('admin' in data) &&
        !('isAdmin' in data) &&
        !('deletionStatus' in data) &&
        !('permissions' in data) &&
        (!('followersCount' in data) || data.followersCount == 0) &&
        (!('followingCount' in data) || data.followingCount == 0) &&
        (!('pinsCount' in data) || data.pinsCount == 0)
      );
    }

    // User profile update validation: strictly prevent modifying protected fields and server counters
    function isValidUserUpdate(userId) {
      return (
        isOwner(userId) && isActiveUser(userId) &&
        !request.resource.data.diff(resource.data).addedKeys().hasAny(['email']) &&
        !request.resource.data.diff(resource.data).changedKeys().hasAny(['email']) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'role', 'admin', 'isAdmin', 'permissions', 'createdAt',
          'followersCount', 'followingCount', 'pinsCount', 'deletionStatus'
        ]) &&
        (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.size() >= 2 && request.resource.data.username.size() <= 50)) &&
        (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 100)) &&
        (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 1000))
      );
    }

    // Pin validation: coordinates, category, title, owner UID
    function isValidPin(data) {
      return (
        data.userId is string && data.userId.size() > 0 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 140 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
        data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
        (data.createdAt is string || data.createdAt is timestamp)
      );
    }

    // Comment validation
    function isValidComment(data) {
      return (
        data.userId is string && data.userId.size() > 0 &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
        (!('pinId' in data) || (data.pinId is string && data.pinId.size() > 0)) &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
        (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 1000)) &&
        (data.createdAt is string || data.createdAt is timestamp)
      );
    }

    // Comment display identity must match the server-readable author profile.
    function hasCanonicalCommentIdentity(data) {
      let author = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return data.userName == author.displayName &&
             data.userAvatar == author.get('avatarUrl', author.get('photoURL', ''));
    }

    // Pin display identity (when present) must match the author's own profile, so
    // users cannot publish spots under another person's name or avatar.
    function hasCanonicalPinIdentity(data) {
      let author = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (!('userName' in data) || data.userName == author.displayName) &&
             (!('userAvatar' in data) || data.userAvatar == author.get('avatarUrl', author.get('photoURL', '')));
    }

    // Location fields are fixed after creation. Editing them would let an author
    // collect new city/country XP repeatedly from the same pin.
    function pinImmutableKeys() {
      return ['userId', 'createdAt', 'likeCount', 'commentCount',
              'latitude', 'longitude', 'geohash',
              'city', 'country', 'countryCode', 'countryName', 'locationName'];
    }

    // Report validation
    function isValidReport(data) {
      return (
        data.reporterId is string && data.reporterId.size() > 0 &&
        data.targetType is string && (data.targetType == 'pin' || data.targetType == 'comment' || data.targetType == 'user') &&
        data.targetId is string && data.targetId.size() > 0 &&
        data.reason is string && data.reason.size() > 0 && data.reason.size() <= 200 &&
        (data.createdAt is string || data.createdAt is timestamp)
      );
    }

    // Server-owned tombstones prevent recreation during and after deletion.
    match /accountDeletionLocks/{userId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // 1. Users Collection: users/{userId}
    // ---------------------------------------------------------
    match /users/{userId} {
      // Public users may read user profiles
      allow read: if true;

      // Only authenticated owner may create their own profile matching auth UID
      allow create: if isNonAnonymous() && isOwner(userId) && usernameRegistryReady() &&
                       !exists(/databases/$(database)/documents/accountDeletionLocks/$(userId)) &&
                       isValidUserCreate(request.resource.data, userId) &&
                       hasUsernameClaim(userId, request.resource.data);

      // Only the authenticated owner may update their own profile (or admin)
      // Users can NEVER modify another user's profile, nor modify protected fields
      allow update: if (isValidUserUpdate(userId) || isAdmin()) && usernameWriteAllowed(userId) &&
                    !request.resource.data.diff(resource.data).addedKeys().hasAny(['email']) &&
                    !request.resource.data.diff(resource.data).changedKeys().hasAny(['email']);

      // Only owner or admin may delete profile
      allow delete: if isOwner(userId) || isAdmin();

      // Followers Subcollection: users/{userId}/followers/{followerId}
      match /followers/{followerId} {
        allow read: if true;
        // Follower UID must match request.auth.uid, anonymous rejected, prevent self-follow
        allow create, update: if isNonAnonymous() && isActiveUser(followerId) && isActiveUser(userId) &&
                                 request.auth.uid == followerId &&
                                 request.auth.uid != userId &&
                                 request.resource.data.followerId == request.auth.uid &&
                                 existsAfter(/databases/$(database)/documents/users/$(followerId)/following/$(userId)) &&
                                 (request.resource.data.createdAt is string || request.resource.data.createdAt is timestamp);
        // Only follower or admin can unfollow (delete)
        allow delete: if isAdmin() || (isOwner(followerId) &&
          !existsAfter(/databases/$(database)/documents/users/$(followerId)/following/$(userId)));
      }

      // Following Subcollection: users/{userId}/following/{targetUserId}
      match /following/{targetUserId} {
        allow read: if true;
        // Only user can add to their own following list, anonymous rejected, cannot follow self
        allow create, update: if isOwner(userId) && isActiveUser(userId) && isActiveUser(targetUserId) &&
                                 isNonAnonymous() &&
                                 request.auth.uid != targetUserId &&
                                 request.resource.data.targetUserId == targetUserId &&
                                  existsAfter(/databases/$(database)/documents/users/$(targetUserId)/followers/$(userId)) &&
                                 (request.resource.data.createdAt is string || request.resource.data.createdAt is timestamp);
        // Only user or admin can remove from following list
        allow delete: if isAdmin() || (isOwner(userId) &&
          !existsAfter(/databases/$(database)/documents/users/$(targetUserId)/followers/$(userId)));
      }

      // Explorer Progression Summary: users/{userId}/progression/{docId}
      // SERVER-AUTHORITATIVE: Client reads permitted; all client writes strictly denied.
      match /progression/{docId} {
        allow read: if true;
        allow write: if false;
      }

      // Explorer Achievements: users/{userId}/achievements/{achievementId}
      // SERVER-AUTHORITATIVE: Client reads permitted; all client writes strictly denied.
      match /achievements/{achievementId} {
        allow read: if true;
        allow write: if false;
      }

      // Explorer XP Event Ledger: users/{userId}/xpEvents/{eventId}
      // SERVER-AUTHORITATIVE: Owner reads permitted; all client writes strictly denied.
      match /xpEvents/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // ---------------------------------------------------------
    // 2. Pins Collection: pins/{pinId}
    // ---------------------------------------------------------
    function hasNewPinImageClaim(pinId, data) {
      let incarnation = data.imageIncarnation;
      let claim = /databases/$(database)/documents/pinImageClaims/$(incarnation);
      let authorized = getAfter(claim).data;
      return validIncarnation(incarnation) && !exists(claim) &&
             authorized.pinId == pinId && authorized.userId == data.userId &&
             authorized.imageUrls == data.get('imageUrls', []);
    }

    function validIncarnation(value) {
      return value is string && value.matches("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}");
    }

    function canPublishWithoutClaim(data) {
      return data.get('imageUrls', []) == [];
    }

    // Only the server may produce an approval or upload receipt. The claim consumes it once.
    match /pinImageClaims/{incarnation} {
      allow create: if isNonAnonymous() && request.auth.token.firebase.get('tenant', '') == '' &&
                    validIncarnation(incarnation) &&
                    matchesImageApproval(incarnation, request.resource.data);
    }

    function matchesImageApproval(incarnation, data) {
      let approved = get(/databases/$(database)/documents/pinImageApprovals/$(incarnation)).data;
      let pin = /databases/$(database)/documents/pins/$(data.pinId);
      return data == approved.claim && data.protocol == 'server-v1' &&
             data.userId == request.auth.uid && request.time < approved.expiresAt &&
             !exists(/databases/$(database)/documents/pinImageCleanupJobs/$(incarnation)) &&
             !exists(pin) && getAfter(pin).data.imageIncarnation == incarnation &&
             getAfter(pin).data.imageUrls == data.imageUrls;
    }

    // Retain an owner-only receipt even if the published pin is later removed.
    match /users/{userId}/pinPublishReceipts/{pinId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isActiveUser(userId) &&
                    request.resource.data.keys().hasOnly(['publishedAt']) &&
                    request.resource.data.publishedAt == request.time &&
                    !exists(/databases/$(database)/documents/pins/$(pinId)) &&
                    getAfter(/databases/$(database)/documents/pins/$(pinId)).data.userId == userId &&
                    getAfter(/databases/$(database)/documents/pins/$(pinId)).data.publishReceipt == true;
    }

    function hasValidPublishReceipt(pinId, data) {
      let receipt = /databases/$(database)/documents/users/$(request.auth.uid)/pinPublishReceipts/$(pinId);
      return !('publishReceipt' in data) ||
             (data.publishReceipt == true && !exists(receipt) && existsAfter(receipt));
    }

    function canEngageWithPin(pinId) {
      let pin = getAfter(/databases/$(database)/documents/pins/$(pinId)).data;
      return pin.userId is string &&
             !exists(/databases/$(database)/documents/accountDeletionLocks/$(pin.userId));
    }

    match /pins/{pinId} {
      // Pins are publicly readable
      allow read: if true;

      // Only authenticated users may create pins; owner UID must equal request.auth.uid
      allow create: if isSignedIn() && isActiveUser(request.auth.uid) &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidPin(request.resource.data) &&
                       hasCanonicalPinIdentity(request.resource.data) &&
                       hasValidPublishReceipt(pinId, request.resource.data) &&
                       (("imageIncarnation" in request.resource.data)
                         ? hasNewPinImageClaim(pinId, request.resource.data)
                         : canPublishWithoutClaim(request.resource.data)) &&
                       (!('likeCount' in request.resource.data) || request.resource.data.likeCount == 0) &&
                       (!('commentCount' in request.resource.data) || request.resource.data.commentCount == 0);

      // Only the pin owner (or admin) may edit their pin
      // Owner UID, createdAt, counters and location fields cannot be modified by the client.
      // Author name/avatar may only change to the author's current canonical profile values.
      allow update: if isSignedIn() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["imageIncarnation", "imageUrls", "publishReceipt"]) && (
        (
          isOwner(resource.data.userId) && isActiveUser(resource.data.userId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(pinImmutableKeys()) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userName', 'userAvatar']) ||
           hasCanonicalPinIdentity(request.resource.data)) &&
          isValidPin(request.resource.data)
        ) ||
        isAdmin()
      );

      // Only the pin owner (or admin) may delete their pin
      allow delete: if isSignedIn() && (
        (isOwner(resource.data.userId) && isActiveUser(resource.data.userId)) || isAdmin()
      );

      // ---------------------------------------------------------
      // 3. Likes Subcollection: pins/{pinId}/likes/{userId}
      // ---------------------------------------------------------
      match /likes/{userId} {
        allow read: if true;
        // Only authenticated non-anonymous users may like; document ID must equal request.auth.uid
        allow create, update: if isNonAnonymous() && isActiveUser(userId) && canEngageWithPin(pinId) &&
                                 request.auth.uid == userId &&
                                 (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);
        // Only the user who liked can unlike (delete)
        allow delete: if isNonAnonymous() && (request.auth.uid == userId || isAdmin());
      }

      // ---------------------------------------------------------
      // 4. Comments Subcollection: pins/{pinId}/comments/{commentId}
      // ---------------------------------------------------------
      match /comments/{commentId} {
        allow read: if true;
        // Authenticated non-anonymous users can create comments; author UID must equal request.auth.uid
        allow create: if isNonAnonymous() && isActiveUser(request.auth.uid) && canEngageWithPin(pinId) &&
                         request.resource.data.userId == request.auth.uid &&
                         (!('pinId' in request.resource.data) || request.resource.data.pinId == pinId) &&
                         isValidComment(request.resource.data) &&
                         hasCanonicalCommentIdentity(request.resource.data);

        // Only comment author can edit comment; author UID and createdAt cannot be changed
        allow update: if isNonAnonymous() && isActiveUser(request.auth.uid) && canEngageWithPin(pinId) &&
                         isOwner(resource.data.userId) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         isValidComment(request.resource.data) &&
                         hasCanonicalCommentIdentity(request.resource.data);

        // Only comment author or admin can delete. Users cannot delete comments belonging to other users
        allow delete: if isNonAnonymous() &&
                         resource != null &&
                         (request.auth.uid == resource.data.userId || isAdmin());
      }
    }

    // ---------------------------------------------------------
    // Moderation Reports Collection: reports/{reportId}
    // ---------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn() && isActiveUser(request.auth.uid) &&
                       request.resource.data.reporterId == request.auth.uid &&
                       isValidReport(request.resource.data) &&
                       (request.resource.data.targetType != 'user' ||
                        !exists(/databases/$(database)/documents/accountDeletionLocks/$(request.resource.data.targetId)));
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // Health Check / Connection Test Endpoint (SKILL.md)
    // ---------------------------------------------------------
    match /test/{docId} {
      allow read: if true;
    }

    // ---------------------------------------------------------
    // Admins Collection: admins/{adminId}
    // ---------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
