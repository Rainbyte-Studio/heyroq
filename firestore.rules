rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // Default Deny All: Prevent any unauthorized document access
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isSignedIn() &&
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Stop authenticated clients from creating new data while account deletion runs.
    function isActiveUser(userId) {
      return !exists(/databases/$(database)/documents/accountDeletionLocks/$(userId)) &&
             exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.get('deletionStatus', '') != 'deleting';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        (request.auth.uid == '1XUiIYnfOWTG7uFU736I25CskZU2' &&
         request.auth.token.email == 'n.kalogerogiannis@gmail.com')
      );
    }

    // User profile creation validation
    function isValidUserCreate(data, userId) {
      return (
        data.username is string && data.username.size() >= 2 && data.username.size() <= 50 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() <= 200 &&
        (!('uid' in data) || data.uid == userId) &&
        (!('role' in data) || data.role == 'user' || isAdmin()) &&
        !('admin' in data) &&
        !('isAdmin' in data) &&
        !('deletionStatus' in data) &&
        !('permissions' in data) &&
        (!('followersCount' in data) || data.followersCount == 0) &&
        (!('followingCount' in data) || data.followingCount == 0) &&
        (!('pinsCount' in data) || data.pinsCount == 0)
      );
    }

    // User profile update validation: strictly prevent modifying protected fields and server counters
    function isValidUserUpdate(userId) {
      return (
        isOwner(userId) && isActiveUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid', 'role', 'admin', 'isAdmin', 'permissions', 'createdAt',
          'followersCount', 'followingCount', 'pinsCount', 'deletionStatus'
        ]) &&
        (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.size() >= 2 && request.resource.data.username.size() <= 50)) &&
        (!('displayName' in request.resource.data) || (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 100)) &&
        (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 1000))
      );
    }

    // Pin validation: coordinates, category, title, owner UID
    function isValidPin(data) {
      return (
        data.userId is string && data.userId.size() > 0 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 140 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        data.latitude is number && data.latitude >= -90.0 && data.latitude <= 90.0 &&
        data.longitude is number && data.longitude >= -180.0 && data.longitude <= 180.0 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
        (data.createdAt is string || data.createdAt is timestamp)
      );
    }

    // Comment validation
    function isValidComment(data) {
      return (
        data.userId is string && data.userId.size() > 0 &&
        data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
        (!('pinId' in data) || (data.pinId is string && data.pinId.size() > 0)) &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
        (!('userAvatar' in data) || (data.userAvatar is string && data.userAvatar.size() <= 1000)) &&
        (data.createdAt is string || data.createdAt is timestamp)
      );
    }

    // Comment display identity must match the server-readable author profile.
    function hasCanonicalCommentIdentity(data) {
      let author = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return data.userName == author.displayName &&
             data.userAvatar == author.get('avatarUrl', author.get('photoURL', ''));
    }

    // Report validation
    function isValidReport(data) {
      return (
        data.reporterId is string && data.reporterId.size() > 0 &&
        data.targetType is string && (data.targetType == 'pin' || data.targetType == 'comment' || data.targetType == 'user') &&
        data.targetId is string && data.targetId.size() > 0 &&
        data.reason is string && data.reason.size() > 0 && data.reason.size() <= 200 &&
        (data.createdAt is string || data.createdAt is timestamp)
      );
    }

    // Server-owned tombstones prevent recreation during and after deletion.
    match /accountDeletionLocks/{userId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // 1. Users Collection: users/{userId}
    // ---------------------------------------------------------
    match /users/{userId} {
      // Public users may read user profiles
      allow read: if true;

      // Only authenticated owner may create their own profile matching auth UID
      allow create: if isOwner(userId) &&
                       !exists(/databases/$(database)/documents/accountDeletionLocks/$(userId)) &&
                       isValidUserCreate(request.resource.data, userId);

      // Only the authenticated owner may update their own profile (or admin)
      // Users can NEVER modify another user's profile, nor modify protected fields
      allow update: if isValidUserUpdate(userId) || isAdmin();

      // Only owner or admin may delete profile
      allow delete: if isOwner(userId) || isAdmin();

      // Followers Subcollection: users/{userId}/followers/{followerId}
      match /followers/{followerId} {
        allow read: if true;
        // Follower UID must match request.auth.uid, anonymous rejected, prevent self-follow
        allow create, update: if isNonAnonymous() && isActiveUser(followerId) && isActiveUser(userId) &&
                                 request.auth.uid == followerId &&
                                 request.auth.uid != userId &&
                                 request.resource.data.followerId == request.auth.uid &&
                                 (request.resource.data.createdAt is string || request.resource.data.createdAt is timestamp);
        // Only follower or admin can unfollow (delete)
        allow delete: if isSignedIn() && (request.auth.uid == followerId || isAdmin());
      }

      // Following Subcollection: users/{userId}/following/{targetUserId}
      match /following/{targetUserId} {
        allow read: if true;
        // Only user can add to their own following list, anonymous rejected, cannot follow self
        allow create, update: if isOwner(userId) && isActiveUser(userId) && isActiveUser(targetUserId) &&
                                 isNonAnonymous() &&
                                 request.auth.uid != targetUserId &&
                                 request.resource.data.targetUserId == targetUserId &&
                                 (request.resource.data.createdAt is string || request.resource.data.createdAt is timestamp);
        // Only user or admin can remove from following list
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Explorer Progression Summary: users/{userId}/progression/{docId}
      // SERVER-AUTHORITATIVE: Client reads permitted; all client writes strictly denied.
      match /progression/{docId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Explorer Achievements: users/{userId}/achievements/{achievementId}
      // SERVER-AUTHORITATIVE: Client reads permitted; all client writes strictly denied.
      match /achievements/{achievementId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // Explorer XP Event Ledger: users/{userId}/xpEvents/{eventId}
      // SERVER-AUTHORITATIVE: Owner reads permitted; all client writes strictly denied.
      match /xpEvents/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    // ---------------------------------------------------------
    // 2. Pins Collection: pins/{pinId}
    // ---------------------------------------------------------
    match /pins/{pinId} {
      // Pins are publicly readable
      allow read: if true;

      // Only authenticated users may create pins; owner UID must equal request.auth.uid
      allow create: if isSignedIn() && isActiveUser(request.auth.uid) &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidPin(request.resource.data) &&
                       (!('likeCount' in request.resource.data) || request.resource.data.likeCount == 0) &&
                       (!('commentCount' in request.resource.data) || request.resource.data.commentCount == 0);

      // Only the pin owner (or admin) may edit their pin
      // Owner UID, createdAt, likeCount, and commentCount cannot be modified by client
      allow update: if isSignedIn() && (
        (
          isOwner(resource.data.userId) && isActiveUser(resource.data.userId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'createdAt', 'likeCount', 'commentCount']) &&
          isValidPin(request.resource.data)
        ) ||
        isAdmin()
      );

      // Only the pin owner (or admin) may delete their pin
      allow delete: if isSignedIn() && (isOwner(resource.data.userId) || isAdmin());

      // ---------------------------------------------------------
      // 3. Likes Subcollection: pins/{pinId}/likes/{userId}
      // ---------------------------------------------------------
      match /likes/{userId} {
        allow read: if true;
        // Only authenticated non-anonymous users may like; document ID must equal request.auth.uid
        allow create, update: if isNonAnonymous() && isActiveUser(userId) &&
                                 request.auth.uid == userId &&
                                 (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);
        // Only the user who liked can unlike (delete)
        allow delete: if isNonAnonymous() && (request.auth.uid == userId || isAdmin());
      }

      // ---------------------------------------------------------
      // 4. Comments Subcollection: pins/{pinId}/comments/{commentId}
      // ---------------------------------------------------------
      match /comments/{commentId} {
        allow read: if true;
        // Authenticated non-anonymous users can create comments; author UID must equal request.auth.uid
        allow create: if isNonAnonymous() && isActiveUser(request.auth.uid) &&
                         request.resource.data.userId == request.auth.uid &&
                         (!('pinId' in request.resource.data) || request.resource.data.pinId == pinId) &&
                         isValidComment(request.resource.data) &&
                         hasCanonicalCommentIdentity(request.resource.data);

        // Only comment author can edit comment; author UID and createdAt cannot be changed
        allow update: if isNonAnonymous() && isActiveUser(request.auth.uid) &&
                         isOwner(resource.data.userId) &&
                         request.resource.data.userId == resource.data.userId &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         isValidComment(request.resource.data) &&
                         hasCanonicalCommentIdentity(request.resource.data);

        // Only comment author or admin can delete. Users cannot delete comments belonging to other users
        allow delete: if isNonAnonymous() &&
                         resource != null &&
                         (request.auth.uid == resource.data.userId || isAdmin());
      }
    }

    // ---------------------------------------------------------
    // Moderation Reports Collection: reports/{reportId}
    // ---------------------------------------------------------
    match /reports/{reportId} {
      allow create: if isSignedIn() && isActiveUser(request.auth.uid) &&
                       request.resource.data.reporterId == request.auth.uid &&
                       isValidReport(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // Health Check / Connection Test Endpoint (SKILL.md)
    // ---------------------------------------------------------
    match /test/{docId} {
      allow read: if true;
    }

    // ---------------------------------------------------------
    // Admins Collection: admins/{adminId}
    // ---------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
